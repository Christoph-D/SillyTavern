{
    "name": "Sillytavern",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode",
                "mrcrowl.easy-less",
                "EditorConfig.EditorConfig",
                "dbaeumer.vscode-eslint"
            ],
            "settings": {}
        }
    },
    "workspaceFolder": "/workspaces/sillytavern",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/sillytavern,type=bind,consistency=cached",
    "remoteUser": "ubuntu",
    "mounts": [
        "source=config-sillytavern,target=/home/ubuntu/persistent-config,type=volume",
        "source=/etc/localtime,target=/usr/share/zoneinfo/hostlocaltime,type=bind,readonly"
    ],
    "postCreateCommand": "bash .devcontainer/setup.sh"
}
